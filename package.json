{
  "name": "la-cave-wine-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition flashcard trainer for learning wine: which grapes grow where, and how to decode a bottle. France-focused.",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 8000 .",
    "test": "node --test tests/*.test.js",
    "start": "uv run python -m http.server 8000",
    "cards": "uv run python scripts/generate_cards.py",
    "validate": "node scripts/validate-cards.mjs",
    "setup:py": "uv sync"
  },
  "keywords": [
    "wine",
    "flashcards",
    "spaced-repetition",
    "pwa"
  ],
  "license": "MIT"
}
