{
  "name": "la-cave",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition flashcard trainer. Multiple decks, one scheduler; currently wine and Spanish.",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 8000 .",
    "test": "node --test tests/*.test.js",
    "start": "uv run python -m http.server 8000",
    "cards": "uv run python scripts/generate_cards.py",
    "cards:es": "uv run python scripts/generate_spanish.py",
    "cards:fr": "uv run python scripts/generate_french.py",
    "validate": "node scripts/validate-cards.mjs",
    "setup:py": "uv sync"
  },
  "keywords": [
    "flashcards",
    "spaced-repetition",
    "pwa",
    "vocabulary",
    "spanish",
    "wine"
  ],
  "license": "MIT"
}
